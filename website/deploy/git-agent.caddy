git-agent.emssion.com {
    root * /srv/git-agent-site/current
    encode zstd gzip

    tls {
        key_type rsa2048
    }

    header {
        -Server
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.github.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'; upgrade-insecure-requests"
    }

    @assets path /assets/* /styles.css /app.js
    header @assets Cache-Control "public, max-age=300"
    @document path / /index.html
    header @document Cache-Control "no-cache"

    file_server
}
